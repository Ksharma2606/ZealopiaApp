{
  "expo": {
    "name": "Zealopia",
    "slug": "zealopia",
    "version": "1.1.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zealopia",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splashscreen-1/ChatGPT Image May 22, 2026, 11_02_44 AM 1.png",
      "resizeMode": "contain",
      "backgroundColor": "#16112B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zealopia.zealopia2",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:api2.zealopia.com"
      ],
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Zealopia to access your microphone to record audio messages for chat.",
        "NSPhotoLibraryUsageDescription": "Allow Zealopia to access your photos to share images in chat."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.zealopia.zealopia2",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "api2.zealopia.com"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "notification": {
      "icon": "./assets/images/android_notification.png",
      "color": "#FFD3E0"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Zealopia to access your microphone to record audio messages for chat."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Zealopia to access your photos to share images in chat."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/SpaceMono.ttf",
            "./assets/fonts/PoppinsSemiBold.ttf",
            "./assets/fonts/PoppinsRegular.ttf",
            "./assets/fonts/PoppinsMedium.ttf",
            "./assets/fonts/KoHo.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
